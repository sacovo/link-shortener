DEBUG=1
SECRET_KEY=secret
SQL_ENGINE=django.db.backends.postgresql

POSTGRES_USER=web
POSTGRES_PASSWORD=password
POSTGRES_DB=django_web

SQL_HOST=db
SQL_PORT=5432
DATABASE=postgres

# The dev server answers on localhost, so links need a Domain named after it.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000;http://localhost:8000
